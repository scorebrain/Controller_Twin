	g_OptJumpers.All = FAKE_JUMPERS;
#endif
}

//======================================================================
//
// SCANCOLUMN: KeyColumn
//
//     - Return the Lowest Column Number With A Low (Active Key)
//
//======================================================================
byte ScanColumn ( void )
{
	// *********************
#ifndef MPLAB_ICD

	if (!Column0F)
		return 1;
	if (!Column1F)
		return 2;
#else

#ifndef REV1LAYOUT  // Comment this block out for Debug. *****
	if (!Column0F)
		return 1;    //Rev2 DEBUG has Col0 on RC4
	if (!Column1F)
		return 2;    //Rev2 DEBUG has Col0 on RC5
#endif //if not REV1LAYOUT
#endif

	// ******************

	if (!Column2F)
		return 3;
	if (!Column3F)
		return 4;
	if (!Column4F)
		return 5;
	if (!Column5F)
		return 6;
	if (!Column6F)
		return 7;
	if (!Column7F)
		return 8;
	return 0;
} //ScanColumn
#endif

//======================================================================
//
// KEYBOARDSCAN: Keyboard Scan
//     - Handles Keyboard Scan, plus all other bit I/O.
//
//======================================================================
void KeyboardScan( void )
{
	static TTwoBytes tKeyTimer = 0;
	// Neither of the below need to be static, but for some inexplicable reason,
	//  when one of them is static the code is smaller.
    unsigned char ucKBRow;		// Fix Reuse Problem?
    unsigned char ucKBInput;	// Fix Reuse Problem?

//----------------------------------------------------------
//
// Process the Remote Switches
//
//----------------------------------------------------------

    ucKBInput = 0;

    if ( !SW4In )                //Lowest Priority First
        ucKBInput = 4;

    if ( !SW3In )
         ucKBInput = 3;

    if ( !SW2In )
         ucKBInput = 2;

	if(g_fTxNormalData)		// Not channel or group scan
	{
		if(ffHandheldData.byNextIn != ffHandheldData.byNextOut)
		{
			static BYTE byState = eHhReceiveWaiting;
			TTwoBytes tbHandheldDataTemp;
			tbHandheldDataTemp.ui = ffHandheldData.aHandheldData[ffHandheldData.byNextOut].ui;
			// Add radar handling  here
			//This needs an "close tunnel".
			switch(byState)
			{
			case eHhReceiveWaiting:
				if(((tbHandheldDataTemp.ui) & 0xBDFF) == 0xA12B)
					//Allow G1B3 or G2B3 to open tunnel
					byState = eHhTunnelOpen;
				break;
			case eHhTunnelOpen:
				if(((tbHandheldDataTemp.by[1]) & 0xFC) == 0xA4)
				{
					// Handheld keys
					ucKBInput = (tbHandheldDataTemp.by[0]);
					if(tbHandheldDataTemp.by[1] & 0x01)
						ucKBInput += 0x80;
					break;
				}
				else if(((tbHandheldDataTemp.by[1]) & 0xFC) == 0xE4)
				{
					// Radar gun
					g_game.Fields.ScoreDetail.BaseBall.ucPitchSpeed = (tbHandheldDataTemp.by[0]);
					g_ScoreUpdFlg.BaseBBits.BatterF = 1;
					g_ScoreUpdFlg.BaseBBits.PitchCntF = 1;
					break;
				}
				else if(((tbHandheldDataTemp.by[1]) & 0xFC) == 0xA8)
				{
					ucKBInput = mxChConflict;
					ucChannelConflict = (tbHandheldDataTemp.by[0]);
					if(tbHandheldDataTemp.by[1] & 0x01)
						ucChannelConflict += 0x80;
					break;
				}
				else
				{
					byState = eHhReceiveWaiting;
					break;
				}
				// Drop thru and close tunnel
//			default:
//				break;
			}
			ffHandheldData.byNextOut = (ffHandheldData.byNextOut + 1) & (HANDHELD_DATA_DEPTH - 1);
		}
	}

    if (!g_SystemFlags.bits.LampTestF) // don't react if in LampTest
    {
        if( g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450) //Evaluate Long and Short Press
        {
            if ( ucKBInput !=2 )   //If C is not pressed
            {
                if ( C_hold > 0 && C_hold < MAX_SHORT_PRESS) //If C was recently short pressed, set CPressedShort to 1
                    g_ClkCtrlFlags.bits.CPressedShort = 1;
                C_hold = 0;    //Reset C_hold whenever button is not being held
            }
            else  //If C is being held
            {
                if( C_hold <MAX_SHORT_PRESS)  //Count up to 2 sec
                    C_hold++;

                if( C_hold == MAX_SHORT_PRESS)
                {
                    g_ClkCtrlFlags.bits.CPressedLong = 1;
                    C_hold = 65000; 							//C_hold will stay unchanged until release
                }
            }
        }
    }

// Precision Time Clock Control. *****

	if ( g_game.Fields.Attribs.bits.PrecisionTimeF && !g_ClockFlags.bits.TODClockF )
	{
		if ( !SW1In && !g_ClockFlags.bits.ClkOnF )
		{
			g_ClockFlags.bits.ClkOnF = 1;
			g_ClockStatus++;
		}
		else if ( SW1In && g_ClockFlags.bits.ClkOnF )
		{
			g_ClockFlags.bits.ClkOnF = 0;
			g_ClockStatus++;
		}
	}
    else if ( !SW1In )                //Highest Priority Last (Overwrites)
         ucKBInput = 1;

    if(ucKBInput)
    {
		g_byGameSaveEnabled = 1;
	    if(ucKBInput < 5)
	    {
		    ucKBInput--;
	        switch ( g_BoardType )
	        {
	             case MMBASEBALL:
	                 ucKBInput = MMBaseballExtSwitches [ucKBInput];
	                 break;

	             case MMCOMBOBASEB:
	                 ucKBInput = MMComboBasebExtSwitches [ucKBInput];
	                 break;

	             case MMCOMBOFOOTB:
	                 ucKBInput = MMComboFootbExtSwitches [ucKBInput];
	                 break;
				 case MPBBB:
	             case MP1390:
	             case MP3450:
	                 ucKBInput = MP1390ExtSwitches [ucKBInput];
	                 break;

#ifdef NO_ETN_DIMMING_SUPPORT
	             case MP14XX:
	                 ucKBInput = MPBaseballExtSwitches [ucKBInput];
	                 break;
#endif

	             case MP15XX:
	                 ucKBInput = MPBaseballExtSwitches [ucKBInput];
	                 break;
	
	             case MPF52:
	                 ucKBInput = MPFootballExtSwitches [ucKBInput];
	                 break;

	             case MPBWV:
	                 ucKBInput = MPBWVExtSwitches [ucKBInput];
	                 break;

#ifdef NO_ETN_DIMMING_SUPPORT
	             case MP14X:
	                 ucKBInput = MPBaseballExtSwitches [ucKBInput];
	                 break;

	             case MP15X:
	                 ucKBInput = MPBaseballExtSwitches [ucKBInput];
	                 break;
#endif

	             default:
	                 ucKBInput = MMBaseballExtSwitches [ucKBInput];

	        }// switch			

	        if ( ( ucKBInput == g_LastExtSw ) && ( g_ExtSwTimer )) // Old Key Still Down
	        {
	            g_ExtSwTimer = DEBOUNCE_TIME; //Refresh (Debounce = Min Off)
	        }
	        else if(!g_SystemFlags.bits.LampTestF) // don't react if in LampTest
	        {
	             // New Switch  (New Press Of the old Switch or a New Switch at Any time)

	             g_LastExtSw = ucKBInput;
	             g_ExtSwTimer = DEBOUNCE_TIME;

	             switch ( ucKBInput )
	             {
	                 case kbCLOCKONOFF:
	                     g_ClkCtrlFlags.bits.ClkOnOffPressedF = 1;
	                     break;
	                 case kbSHOTDELAYENABLE:
	                     g_ClkCtrlFlags.bits.ShotOnOffPressedF = 1;
	                     break;
	                 case kbSHOTDELAYRESET:
	                     g_ClkCtrlFlags.bits.ShotResetPressedF = 1;
	                     break;
	                 case kbSHOTDELAYONOFF:
	                     g_ClkCtrlFlags.bits.ShotRunStopPressedF = 1;
	                     break;
	                 case kbOBDELAYRESET:
	                     g_ClkCtrlFlags.bits.OBResetPressedF = 1;
	                     break;
	             }
	        }
	    }
		else // Received input from Handheld
		{
			do
			{
				g_KeyInput = SPARSE_SEARCH(ucKBInput, GameClockHandheld);
				if(kbNone != g_KeyInput)
				{
					if((kbCLOCKON == g_KeyInput) && !g_ClockFlags.bits.ClkOnF)
						g_ClkCtrlFlags.bits.ClkOnOffPressedF = 1;
					else if((kbCLOCKOFF == g_KeyInput) && g_ClockFlags.bits.ClkOnF)
						g_ClkCtrlFlags.bits.ClkOnOffPressedF = 1;
					break;
				}
				g_KeyInput = SPARSE_SEARCH(ucKBInput, SegmentTimerHandheld);
				if(kbNone != g_KeyInput)
					break;
				g_KeyInput = SPARSE_SEARCH(ucKBInput, BaseballHandheld);
				if(kbNone != g_KeyInput)
					break;
				g_KeyInput = SPARSE_SEARCH(ucKBInput, PitchCountHandheld);
				if(kbNone != g_KeyInput)
					break;
				g_KeyInput = SPARSE_SEARCH(ucKBInput, GroupMsgMic);
				if(kbNone != g_KeyInput)
					break;
			}while(FALSE);
			// don't react if in LampTest                
			if ( g_KeyInput == kbCLOCKONOFF && !g_SystemFlags.bits.LampTestF )
			{
				g_ClkCtrlFlags.bits.ClkOnOffPressedF = 1;

				g_KeyInput = kbNone;  //We have Already Handled It Locally
			}
		}
	}

//----------------------------------------------------------
//
// Read Rows 0-4 Stopping at the First Key Found
//
//----------------------------------------------------------

	if(ucKBInput < 5)
	{
//		TRISB = 0xFF;  // RB0-RB7=Column0-Column7

#ifdef REV2LAYOUT
#ifdef MPLAB_ICD
		TRISC |= 0x30;  //RC4,RC5 = input for REV2 Debug
#endif
#endif

		RowJF = 1; // dip Switches OFF

		RowHF = 1;
		RowGF = 1;
		RowFF = 1;
		RowEF = 1;
		RowDF = 1;
		RowCF = 1;
		RowBF = 1;


		RowAF = 0;               // Select Row 0
		ucKBRow = 00;            // Offset in the Keynumber for Row A

		ucKBInput = ScanColumn();

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowAF = 1;
			RowBF = 0;         // Select Row 1
			ucKBRow = 1;       // Offset in the Keynumber for Row B
			ucKBInput = ScanColumn();
		}

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowBF = 1;
			RowCF = 0;         // Select Row 2
			ucKBRow = 2;       // Offset in the Keynumber for Row C
			ucKBInput = ScanColumn();
		}

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowCF = 1;
			RowDF = 0;         // Select Row 3
			ucKBRow = 3;       // Offset in the Keynumber for Row D
			ucKBInput = ScanColumn();
		}

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowDF = 1;
			RowEF = 0;         // Select Row 4
			ucKBRow = 4;       // Offset in the Keynumber for Row E
			ucKBInput = ScanColumn();
		}

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowEF = 1;
			RowFF = 0;         // Select Row 6
			ucKBRow = 5;       // Offset in the Keynumber for Row F
			ucKBInput = ScanColumn();
		}

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowFF = 1;
			RowGF = 0;         // Select Row 7
			ucKBRow = 6;       // Offset in the Keynumber for Row G
			ucKBInput = ScanColumn();
		}

		if (!ucKBInput)  // if no Keys Found Yet
		{
			RowGF = 1;
			RowHF = 0;         // Select Row 4
			ucKBRow = 7;       // Offset in the Keynumber for Row H
			ucKBInput = ScanColumn();
		}

// Process Any Key Found

        if ( ucKBInput )
        {
			g_byGameSaveEnabled = 1;
	        ucKBInput--;
           switch ( g_BoardType )
           {
                case MMBASEBALL:
                     ucKBInput = MMBaseballKeyboard [ucKBRow][ucKBInput];
                     break;
                case MMCOMBOBASEB:
#ifdef IMPROVED_INCANDESCENT_SUPPORT
		             if((g_ModelSel == 1))
			             ucKBInput = MMBaseballKeyboard [ucKBRow][ucKBInput];
		             else
#endif
	                     ucKBInput = MMComboBasebKeyboard [ucKBRow][ucKBInput];
                     break;

                case MMCOMBOFOOTB:
                     ucKBInput = MMComboFootbKeyboard [ucKBRow][ucKBInput];
                     break;
				 
			    case MPBBB:
                case MP1390:
                case MP3450:
                     ucKBInput = MP1390Keyboard [ucKBRow][ucKBInput];
                     break;

                case MPF52:
                     ucKBInput = MPFootballKeyboard [ucKBRow][ucKBInput];
                     break;

                case MPBWV:
                     ucKBInput = MPBWVKeyboard [ucKBRow][ucKBInput];
                     break;

#ifdef NO_ETN_DIMMING_SUPPORT
                case MP14XX:
                     ucKBInput = MPBaseballKeyboard [ucKBRow][ucKBInput];
                     break;
#endif

                case MP15XX:
                     ucKBInput = MPBaseballKeyboard [ucKBRow][ucKBInput];
                     break;

#ifdef NO_ETN_DIMMING_SUPPORT
                case MP14X:
                     ucKBInput = MPBaseballKeyboard [ucKBRow][ucKBInput];
                     break;

                case MP15X:
                     ucKBInput = MPBaseballKeyboard [ucKBRow][ucKBInput];
                     break;
#endif

                default:
                     ucKBInput = MMBaseballKeyboard [ucKBRow][ucKBInput];
            }// switch

            if ( (ucKBInput == (g_LastKey & 0x7F)) && ( g_KeyTimer )) // Old Key Still Down
            {
	            //Attempted fix of debounce routine, doesn't appear to be successful
	            NonRepeatKeyCount = 3;
                g_KeyTimer = DEBOUNCE_TIME; //Refresh (Debounce = Min Off)
				// A key is pressed that is not a new press
				di();
				if(g_Timer.ui - tKeyTimer.ui > LONG_PRESS_TIME)
				{
					// It has been pressed for a long time.
					tKeyTimer.ui = g_Timer.ui - LONG_PRESS_TIME - 10;	// Make the timer follow the current time in case someone holds a key for more than 650 seconds.
					if(!(g_LastKey & 0x80))
						g_KeyInput = g_LastKey = LONG_PRESS(ucKBInput);
				}
				ei();
            }
            else if(NonRepeatKeyCount && (ucKBInput != (g_LastKey & 0x7F)))
            {
	            NonRepeatKeyCount--;
            }
            else
            {
                // New Key  (New Press Of the old Key or a New Key at Any time)

	            NonRepeatKeyCount = 3;
                g_KeyInput = g_LastKey = ucKBInput;
                g_KeyTimer = DEBOUNCE_TIME;
                di();
				tKeyTimer.ui = g_Timer.ui;		// Long press timer
				ei();
				
				if(g_KeyInput != kbYTGRESET)
				g_LastKeyYTG = 0;

                // don't react if in LampTest                
                if ( ucKBInput == kbCLOCKONOFF && !g_SystemFlags.bits.LampTestF )
                {
                    g_ClkCtrlFlags.bits.ClkOnOffPressedF = 1;

                    g_KeyInput = kbNone;  //We have Already Handled It Locally
                }
            }
        }
	}

//-----------------------------------------------------------
//
// Idle Foreground Tasks
//
//   (The User Interface doesn't return to the main loop during
//    User interaction, but it does scan the keyboard, so all
//    house keeping chores are done here)
//
//----------------------------------------------------------

    g_SystemFlags.bits.ResetF = 1;                    //Flag Interrupt To Hit WatchDog

//
// Process the CLock Control Flags
//
	//
	// Toggle the Game Clock On/Off?
	//
    if ( g_ClkCtrlFlags.bits.ClkOnOffPressedF )
    {
	    if ( g_ClockFlags.bits.TODClockF )	// Clear button if TOD is active.
	    {
		    g_ClkCtrlFlags.bits.ClkOnOffPressedF = 0;
		}
		else if(SegTimerEntry)
		{
		    g_ClkCtrlFlags.bits.ClkOnOffPressedF = 0;
		}
		else
		{
			g_ClockFlags.bits.ClkOnF ^= 1;   //Toggle the Clock
			g_ClockStatus++;
		}
    }

	//
	// Take care of the Shot Clock Functions
	//
    if (( g_ClkCtrlFlags.bits.CPressedShort || g_ClkCtrlFlags.bits.CPressedLong || g_ClkCtrlFlags.bits.ShotOnOffPressedF ||
          g_ClkCtrlFlags.bits.ShotResetPressedF || g_ClkCtrlFlags.bits.OBResetPressedF) && !g_ClockFlags.bits.TODClockF )
    {
        // Skip Football 
        if (!(g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450))
        {
	        if ( g_ClkCtrlFlags.bits.ShotOnOffPressedF )
	        {
	            g_ClockFlags.bits.SClkEnableF ^= 1; //Toggle the Shot CLock Enable
	            if ( !g_ClockFlags.bits.SClkEnableF )
	            {
					g_ShotDly10 = 0;
					g_ShotDly01 = 0;   
				}         	
	        }
        }

		// Process short or long press of C button
        //After short press
		if ( g_ClkCtrlFlags.bits.CPressedShort &&
             ( g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450 ) )
		{
			if ( g_ClockFlags.bits.SClkEnableF) //Display On
			{	
				if ( g_ShotDly10 == 0 && g_ShotDly01 == 0)    //Turn off Display if timer == 0
					g_ClockFlags.bits.SClkEnableF = 0;
				else
				{
                    g_ClockFlags.bits.SClkOnF ^= 1;   //Toggle Run/Stop
				}
			}
			else     //Display Off
			{
				g_ClockFlags.bits.SClkEnableF = 1;
			}
		}

        //After long press
		if ( g_ClkCtrlFlags.bits.CPressedLong &&
             ( g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450 ) )
		{
			if(!g_ClockFlags.bits.SClkOnF)
				g_ClockFlags.bits.SClkEnableF ^= 1;	//Toggle DGT Power
            g_ShotDly10 = 0;
            g_ShotDly01 = 0;
		}
		else if ( g_ClkCtrlFlags.bits.OBResetPressedF) 		// Reset to OB and Enable Clock.
		{
			g_ShotDly10    = g_game.Fields.ShotDlyReset2 / 10;
	        g_ShotDly01    = g_game.Fields.ShotDlyReset2 % 10;
	        g_ShotDlyTenth = 9;
	        g_ClockFlags.bits.SClkEnableF = 1;
			if ( g_BoardType == MPBWV)
                g_ClockFlags.bits.SClkOnF = g_ClockFlags.bits.SClkEnableF;
	    }
	    // Reset to ShotDelay and Enable Clock.
	    else if ( g_ClkCtrlFlags.bits.ShotResetPressedF )  //Turn on Shot Clock, Set to RESET1
		{
			g_ShotDly10    = g_game.Fields.ShotDlyReset / 10;
	       	g_ShotDly01    = g_game.Fields.ShotDlyReset % 10;	
			g_ShotDlyTenth = 9;
	        g_ClockFlags.bits.SClkEnableF = 1;       //Turns on DOG clock display when reset is pressed
			if (g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450)
				g_ClockFlags.bits.SClkOnF = 0;  //Stop Clock for Football
			if ( g_BoardType == MPBWV)
                g_ClockFlags.bits.SClkOnF = g_ClockFlags.bits.SClkEnableF;
	    }
        
        g_ClockStatus++;
    }

    if ( g_ClkCtrlFlags.bits.ShotRunStopPressedF & !g_ClockFlags.bits.TODClockF )	// Football and 1390
    {
        //Turn on Shot Clock, Set to RESET2 and Stop
		if ( g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450 )
		{
			g_ShotDly10    = g_game.Fields.ShotDlyReset2 / 10;
	       	g_ShotDly01    = g_game.Fields.ShotDlyReset2 % 10;	
			g_ShotDlyTenth = 9;
	        g_ClockFlags.bits.SClkEnableF = 1;       //Turns on DOG clock display when reset is pressed
			g_ClockFlags.bits.SClkOnF = 0;

		}
		else
	     	g_ClockFlags.bits.SClkOnF ^= 1;
       g_ClockStatus++;
    }
    
    if ( !g_ClockFlags.bits.SClkEnableF )
        g_ClockFlags.bits.SClkOnF = 0;


    g_ClkCtrlFlags.AllFlags = 0;  //We have Processed the CLock Control so Clear the Flags


    if( g_ClockFlags.bits.ClkOnF )                    //If Clock is On
    {
        g_ClockFlags.bits.TODClockF = 0;              //Time Of Day Clock Off
        g_ClockFlags.bits.TimeOutF = 0;               //IimeOut Clock Off
    }
    else if( g_ClockFlags.bits.TimeOutF )             //If TimeOut Clock is On
    {
        g_ClockFlags.bits.TODClockF = 0;              //Time of day clock OFF
    }


//
// If THe Flash Phase Timer Has Expired, then Process Scoreboard to Update Flashes
//

//Now 1/2Sec!!!     //used to do this once every 60th of a second, now we do it every 10th second.

    if (!g_ucFlashTimer)
    {
        g_ucFlashTimer = SYSTICKRATE/2;
        g_ucFlashCount--;
        ScoreMod();   //Update the Scoreboard to Handle Error/HitFlash
    }                                       // End If - Flash Timer

    if( g_ClockStatus )         // Refresh clock if it has changed.
    {
       // If the Shot Clock is <= Game Clock then Blank it
       	if ( CLOCK_ZERO_TEST3(Hours, Min10, Min01) )
        {
        	if ( (g_game.Fields.GClock.Sec10*100 + g_game.Fields.GClock.Sec01*10 + g_game.Fields.GClock.Sec10th) <=
                 (g_ShotDly10*100 + g_ShotDly01*10 + g_ShotDlyTenth - 9) ) // check for .9 less on the shot clock
        	{
				if(g_OptJumpers.MPBWVBBits.JCJCMode && g_BoardType == MPBWV)
					g_ShotDly10 = g_ShotDly01 = g_ShotDlyTenth = 0;
				else
				{	
                    if ( g_BoardType == MPF52 || g_BoardType == MMCOMBOFOOTB || g_BoardType == MP1390 || g_BoardType == MP3450 )
                        ;
       	        	else
					{
                        g_ClockFlags.bits.SClkEnableF = 0; // Force Blank if <= Game Clock
                        g_ClockFlags.bits.SClkOnF = 0;
					}
				}
    		}
		}
        ClockMod();
        g_ClockStatus = 0;
  	}

//-----------------------------------------------------------------
//
// Set Remote GameCLock & Shot Clock LEDs
//
//-----------------------------------------------------------------

    if ( g_ClockFlags.bits.ClkOnF )
    	GClkOut = 0;
    else
    	GClkOut = 1;
    	
	if(g_BoardType != MPBWV)
	{
#ifndef DISABLE_SHOTCLOCK
        SClkOut = !g_ClockFlags.bits.SClkOnF;
#endif
	}
}

void ProcessTenthsSecs(VoidVoidFunc pTenthsFunc)
{
	//disabled for MPBBB
	//disabled for MP15XX w/GClck3Dig installed
	//valid for SegTimer Mode AND
	//  a) either 4-dig display OR TKClock ONLY

	if( (g_BoardType == MPBBB) ||
	    (g_BoardType == MP15XX && g_OptJumpers.MPB15Bits.GClck3Dig) )
	    ;
	else if ( (g_SystemFlags.bits.SegmentTimerF) && ( (Clk_Settings & CLK_SETTINGS_4D) ||
	                                                  ((g_BoardType == MPF52) && (g_OptJumpers.MPFootBBits.TKClock == 1)) ) )
