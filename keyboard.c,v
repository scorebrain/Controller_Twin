{
    if( g_KeyInput != kbNone )
    {
        switch( g_KeyInput )
        {
        case kbSETCLOCK:
            SetClock();
            break;

        case kbTIMEOFDAY:
            //disabled for MMBASEBALL w/GClk3Dig Jumper installed
            //disabled for MPBBB w/GClk3Dig Jumper installed
            //disabled for MP1390 in Baseball Mode w/GClk3Dig Jumper installed
            //disabled for MP3450 in Baseball Mode with or without jumper
            //disabled for MP15XX w/J1B installed (3-digit clock)
            //disabled for SegmentTimer for 2 digits
            if( !(g_BoardType == MMBASEBALL && g_OptJumpers.MMBaseBBits.GClck3Dig) &&
                !(g_BoardType == MPBBB && g_OptJumpers.MMBaseBBits.GClck3Dig) &&
                !(g_BoardType == MP1390 && !(g_game.Fields.ScoreboardModel & MULTISPORTFOOTBALL) && g_OptJumpers.MP1390Bits.GClck3Dig) &&
                !(g_BoardType == MP3450 && !(g_game.Fields.ScoreboardModel & MULTISPORTFOOTBALL)) &&
                !(g_BoardType == MP15XX && g_OptJumpers.MPB15Bits.GClck3Dig) &&
                !(g_SystemFlags.bits.SegmentTimerF && (numDigits == 2)))
                SetTimeOfDay();
            break;
             
        case kbNEWGAME:
            NewGame();
            break;
            
        case kbNextSeg:
			if(!g_ClockFlags.bits.ClkOnF)
			{
				NextSeg();
				if(!IntervalF)
					NextSeg();		//Skip over interval if it is an interval
			}
            break;
            
        case kbPERIOD:
			if(!(g_SystemFlags.bits.SegmentTimerF && g_ClockFlags.bits.TimeOutF))
                Period_1();
            break;

        case kbSETCLOCK10TH:
			ProcessTenthsSecs(SetTenthSec);
            break;
            
