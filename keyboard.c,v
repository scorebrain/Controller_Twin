void ReadJumpers( void )
{
    RowHF = 1;
    RowAF = 1;
    RowBF = 1;
    RowCF = 1;
    RowDF = 1;
    RowEF = 1;
    RowFF = 1;
    RowGF = 1;

    RowJF = 0; // Select dip Switches


//    TRISB = 0xFF;  // RB0-RB7=Column0-Column7
#ifdef REV2LAYOUT
#ifdef MPLAB_ICD
    TRISC |= 0x30;  //RC4,RC5 = input for REV2 Debug
#endif
#endif
    g_OptJumpers.All = 0x00;

#ifndef MPLAB_ICD

//  Read DipSwitches

    if (!Column0F)
        g_OptJumpers.All |= 0x01;

    if (!Column1F)
        g_OptJumpers.All |= 0x02;
#else
#ifdef REV1LAYOUT
    g_OptJumpers.All |= 0x01;      // Set 0-99 Scores if ICD on REV1
#else
    if (!Column0F)
        g_OptJumpers.All |= 0x01;    //Rev2 DEBUG has Col0 on RC4

    if (!Column1F)
        g_OptJumpers.All |= 0x02;    //Rev2 DEBUG has Col0 on RC5

#endif //REV1LAYOUT else
#endif
    if (!Column2F)
        g_OptJumpers.All |= 0x04;

    if (!Column3F)
        g_OptJumpers.All |= 0x08;

    if (!Column4F)
        g_OptJumpers.All |= 0x10;

    if (!Column5F)
        g_OptJumpers.All |= 0x20;

    if (!Column6F)
        g_OptJumpers.All |= 0x40;

    if (!Column7F)
        g_OptJumpers.All |= 0x80;

    RowHF = 1;
